# Environment
ENV=development

# Database
DATABASE_URL=postgresql://invex_user:invex_password@localhost:5432/invex_db
# For SQLite fallback, use:
# DATABASE_URL=sqlite:///./invex.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate Limits
RATE_LIMIT_AGENT=3/hour
RATE_LIMIT_PORTFOLIO=30/minute
RATE_LIMIT_MARKET=60/minute

# LLM Keys
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=invex-crew-v2
